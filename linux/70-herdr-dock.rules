# herdr-dock: let the logged-in desktop user use the StreamDock M18 (via logind's uaccess ACL).
# Must sort before 73-seat-late.rules so the uaccess tag is applied.
# 5548:1000 VSDinside-branded M18 ("HOTSPOTEKUSB HID DEMO"); 6603:1009/1012 StreamDock M18.
SUBSYSTEM=="usb", ATTR{idVendor}=="5548", ATTR{idProduct}=="1000", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="6603", ATTR{idProduct}=="1009", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="6603", ATTR{idProduct}=="1012", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="5548", ATTRS{idProduct}=="1000", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1009", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1012", TAG+="uaccess"
